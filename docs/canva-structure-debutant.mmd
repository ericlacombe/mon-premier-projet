%% Canva structure de fichiers - mon-premier-projet - NIVEAU DEBUTANT
%% Rendu : copier ce bloc sur https://mermaid.live
%% Legende : fleche pleine = arborescence (dossier contient fichier)
%%           fleche pointillee + texte = import Python (le texte = le nom importe)
flowchart TB
    ROOT["mon-premier-projet - niveau debutant"]

    ROOT --> README["README.md"]
    ROOT --> REQ["requirements.txt"]

    subgraph APP["app - code API"]
        A_APP["app.py - Flask blueprints run"]
        A_DB["db.py - engine session"]
        A_MODELS["modelsSQLAlchemy.py - Base User"]
        A_ROUTES["routes/auth.py - POST /api/auth/register"]
    end

    subgraph TESTS["tests - tests"]
        T_AUTH["test_auth.py"]
    end

    subgraph DOCS["docs - documentation"]
        D_ATT["attentes.md"]
        D_MET["methodologie.md"]
        D_CANVA["methodologie-canva.mmd"]
        D_ETAPES["etape0 a etape6"]
    end

    ROOT --> APP
    ROOT --> TESTS
    ROOT --> DOCS

    A_APP -.->|auth_bp| A_ROUTES
    A_APP -.->|session| A_DB
    A_APP -.->|User| A_MODELS
    A_DB -.->|Base| A_MODELS
    A_ROUTES -.->|session User| A_DB
    A_ROUTES -.->|User| A_MODELS
    T_AUTH -.->|app| A_APP
    T_AUTH -.->|Base User| A_MODELS
    T_AUTH -.->|auth_module| A_ROUTES

    style APP fill:#e8f4ff,stroke:#3b82f6
    style TESTS fill:#f0fdf4,stroke:#22c55e
    style DOCS fill:#fdf2f8,stroke:#ec4899
